{
  "name": "interro",
  "productName": "INTERRO",
  "private": true,
  "version": "0.0.1",
  "description": "AI 범죄 심리 추리 게임",
  "author": "dubu-maker",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite",
    "build:web": "tsc -b && vite build",
    "build:desktop": "node scripts/clean-desktop.mjs && tsc -p tsconfig.electron-build.json",
    "build": "npm run build:web && npm run build:desktop",
    "desktop:start": "npm run build && electron .",
    "desktop:smoke": "npm run build && electron . --smoke-test",
    "desktop:openai": "pwsh -NoProfile -File scripts/launch-openai.ps1",
    "openai:smoke": "pwsh -NoProfile -File scripts/launch-openai.ps1 -SmokeTest",
    "steam:package": "npm run build && electron-forge package --platform=win32 --arch=x64",
    "preview": "vite preview",
    "beta:case3": "tsx src/test/beta-case3.ts",
    "redteam": "tsx src/test/redteam.ts",
    "simulate": "tsx src/test/simulate.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@types/node": "^26.1.1",
    "electron": "43.2.0",
    "phaser": "4.2.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "tar": "7.5.21",
    "tmp": "0.2.7"
  }
}
